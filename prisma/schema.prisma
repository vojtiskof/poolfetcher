generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OccupancyRecord {
  id            Int      @id @default(autoincrement())
  timestamp     DateTime @default(now())
  poolId        String   @default("nymburk")
  poolCount     Int
}
